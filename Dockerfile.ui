FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PIP_DISABLE_PIP_VERSION_CHECK=1 \
  PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

COPY requirements-ui.txt ./
RUN python -m pip install -U pip \
  && pip install -r requirements-ui.txt

COPY src ./src
ENV PYTHONPATH=/app/src

# Bundle 3Dmol.js locally so the UI works in locked-down networks.
RUN mkdir -p /app/src/rf3_demo_ui/static \
  && curl -fsSLo /app/src/rf3_demo_ui/static/3Dmol-min.js \
    https://3dmol.csb.pitt.edu/build/3Dmol-min.js

EXPOSE 8080

CMD ["python", "-m", "rf3_demo_ui"]
